# Application
PORT=3000
# Shared Postgres (Neon). Required — the book is shared across machines.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-value

# xAI – used for structured market creation, market analysis, and source-backed settlement research.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# X OAuth confidential-web-app settings. Never commit actual values.
# Add http://localhost:3000/auth/x/callback to the app's callback URLs.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# Optional: provision the one market bot directly for a demo.
# Tokens require tweet.read users.read tweet.write; include offline.access only
# if you use the OAuth callback/refresh-token flow.
X_BOT_USER_ID=
X_BOT_ACCESS_TOKEN=
