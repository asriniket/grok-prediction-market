# Application
PORT=3000
DATABASE_PATH=./data/karma-markets.sqlite
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-long-random-value

# xAI – used only to turn an X post into a structured market question.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# X OAuth confidential-web-app settings. Never commit actual values.
# Add http://localhost:3000/auth/x/callback to the app's callback URLs.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# Optional: provision the one market bot directly for a demo.
# Tokens require tweet.read users.read tweet.write; include offline.access only
# if you use the OAuth callback/refresh-token flow.
X_BOT_USER_ID=
X_BOT_ACCESS_TOKEN=
