# Application
PORT=3000
# Shared Postgres (Neon). Required — the book is shared across machines.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
APP_URL=http://localhost:3000
INTERNAL_JOB_SECRET=replace-with-a-long-random-value

# xAI – used for structured market creation, market analysis, and source-backed settlement research.
XAI_API_KEY=
XAI_MODEL=grok-4.3

# X OAuth confidential-web-app settings. Never commit actual values.
# Add http://localhost:3000/auth/x/callback to the app's callback URLs.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# X Account Activity API webhook. This is the Consumer/API Secret from the
# "Keys and tokens" page, not the OAuth 2.0 client secret above.
X_CONSUMER_SECRET=

# Optional: provision the one market bot directly for a demo.
# Tokens require tweet.read users.read tweet.write; include offline.access only
# if you use the OAuth callback/refresh-token flow. This is OAuth 2.0—not the
# OAuth 1.0a access-token pair X requires when creating an AAA subscription.
X_BOT_USER_ID=
X_BOT_OAUTH2_ACCESS_TOKEN=

# Optional: enable the integrated /live channel on this server.
LIVE_BROADCAST_ENABLED=0
